{
  "name": "recreate-the-world",
  "version": "0.1.0",
  "private": true,
  "description": "Repo tooling: commit message linting (husky + commitlint) and branch name check",
  "scripts": {
    "commitlint": "commitlint",
    "check:branch": "sh scripts/check-branch-name.sh",
    "check:format": "bash scripts/check-format.sh",
    "check:unity": "bash scripts/check-unity-project.sh",
    "check:csharp": "bash scripts/check-csharp-format.sh",
    "check:ci": "bash scripts/check-ci-scripts.sh",
    "format:csharp": "dotnet csharpier src/Recreate_The_World/Assets",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
