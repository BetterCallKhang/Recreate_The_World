root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Unity sinh file .meta theo format rieng, khong tu dong sua
[*.meta]
trim_trailing_whitespace = false

[*.{json,asmdef,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
# Quy uoc dat ten C# (IDE se canh bao khi lech)
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = pascal_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.pascal_i.capitalization = pascal_case
dotnet_naming_style.pascal_i.required_prefix = I
