# ==========================================
# Repo-level .gitignore
# Chỉ chứa những gì thuộc phạm vi repo (OS, IDE, secrets, web, CI/CD).
# Cấu hình riêng của Unity nằm trong src/Recreate_The_World/.gitignore
# ==========================================

# ==========================================
# OS & System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*~

# ==========================================
# IDEs & Editors (Rider, VS, VS Code, Neovim)
# ==========================================
.idea/
*.iml
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# Node tooling (husky, commitlint)
# ==========================================
node_modules/
.husky/_/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Web Project (src/download-web/)
# ==========================================
dist/
build/
.next/
out/
.nuxt/
.cache/
.turbo/
coverage/
.nyc_output/
*.tsbuildinfo

# ==========================================
# Docker & CI/CD Local Artifacts
# ==========================================
.docker/
*.tar
*.tar.gz
*.zip
